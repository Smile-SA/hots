{
  "time_limit": null,
  "clustering": {
    "method": "kmeans",
    "nb_clusters": 3,
    "parameters": {
      "nb_clusters": 3
    }
  },
  "optimization": {
    "backend": "pyomo",
    "parameters": {
      "solver": "glpk",
      "verbose": 0
    }
  },
  "problem": {
    "type": "placement",
    "parameters": {
      "initial_placement": 0,
      "tol": 0.1,
      "tol_move": 0.5
    }
  },
  "connector": {
    "type": "file",
    "parameters": {
      "data_folder": "./tests/data/thesis_ex_10",
      "file_name": "container_usage.csv",
      "tick_field": "timestamp",
      "individual_field": "container_id",
      "host_field": "machine_id",
      "metrics": ["cpu"],
      "sep_time": 3,
      "tick_increment": 2,
      "window_duration" : 3,
      "outfile": "./out/moves.log"
    }
  },
  "logging": {
    "level": "INFO",
    "filename": "./out/hots.log",
    "fmt": "%(asctime)s %(levelname)s: %(message)s"
  },
  "reporting": {
    "results_folder": "./out",
    "metrics_file": "./out/metrics.csv",
    "plots_folder": "./out/plots"
  },
  "visualization": {
    "enabled": false,
    "default_metric": "cpu",
    "save": {
      "enabled": true,
      "plots_folder": "./out/plots",
      "default_format": "png",
      "dpi": 150,
      "bbox_inches": "tight",
      "close_on_save": true
    },
    "colors": {
      "clusters": [
        "blue", "orange", "green", "red", "purple",
        "brown", "pink", "gray", "olive", "cyan",
        "turquoise", "chocolate", "navy", "lightcoral", "violet"
      ],
      "highlight": ["violet", "lightcoral", "navy", "chocolate", "turquoise"]
    },
    "dendrogram": {
      "leaf_rotation": 90.0,
      "leaf_font_size": 8.0
    },
    "graphs": {
      "spring_layout": {
        "k": 0.15,
        "iterations": 20
      },
      "show_edge_weights": true
    },
    "nodes": {
      "capacity_margin_ratio": 0.2,
      "sep_time_color": "red",
      "sep_time_style": "--",
      "capacity_color": "red"
    },
    "live": {
      "pause_seconds": 0.5
    },
    "naming": {
      "prefix": "",
      "suffix": "",
      "slugify": true
    }
  }
}
