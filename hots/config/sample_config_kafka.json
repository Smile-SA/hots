{
  "time_limit": 600,
  "data": {
    "tick_field": "timestamp",
    "individual_field": "container_id",
    "host_field": "machine_id",
    "metrics": ["cpu"]
  },
  "clustering": {
    "method": "kmeans",
    "nb_clusters": 3,
    "parameters": {
      "nb_clusters": 3
    }
  },
  "optimization": {
    "backend": "pyomo",
    "parameters": {
      "pb_number": 1,
      "solver": "glpk"
    }
  },
  "problem": {
    "type": "placement",
    "parameters": {
      "initial_placement": false,
      "tol": 0.1,
      "tol_move": 0.2
    }
  },
  "connector": {
    "type": "kafka",
    "parameters": {
      "sep_time": 30,
      "_comment_sep_time": "With live Kafka and real Prometheus timestamps (Unix epoch ~1.7e9), any value below 1e9 is satisfied by the very first message — bootstrap always completes on batch 1. Only set this to a meaningful wall-clock value when using the FileConnector.",
      "tick_increment": 10,
      "window_duration": 3,
      "bootstrap.servers": "localhost:9092",
      "topic_data": "hots_data",
      "topic_moves": "hots_moves",
      "consumer_conf": {
        "bootstrap.servers": "localhost:9092",
        "group.id": "hots",
        "auto.offset.reset": "earliest"
      },
      "batch_size": 10,
      "poll_timeout": 1.0,
      "bootstrap_timeout_seconds": 120,
      "node_capacities": {
        "vm1": 2.0,
        "vm2": 2.0,
        "vm3": 2.0
      }
    }
  },
  "logging": {
    "level": "INFO",
    "filename": "./out/hots.log",
    "fmt": "%(asctime)s %(levelname)s: %(message)s"
  },
  "reporting": {
    "results_folder": "./out",
    "metrics_file": "./out/metrics.csv",
    "plots_folder": "./out/plots"
  },
  "visualization": {
    "enabled": false
  }
}
